# Fresher Sprint environment template. Placeholders only: never commit real values.
#
#   Docker event stack:  cp .env.example .env.event   (fill in section 1)
#   Local development:   cp .env.example .env         (see section 2)
#
# Generate each secret with:  openssl rand -hex 32

# =====================================================================
# 1. Docker event stack (docker-compose.event.yml reads these)
# =====================================================================

# Postgres password for the event database. Required (left empty: compose refuses to start).
POSTGRES_PASSWORD=

# Signs login tokens; shared by api and gateway. Required.
# The old development default is rejected when NODE_ENV=production.
JWT_SECRET=

# Password for the "admin" account created on first start. Required, 12+ characters.
ADMIN_PASSWORD=

# Trader session lifetime in seconds (12 hours).
JWT_EXPIRES_IN=43200

# Host port for the LAN entry point (http://<host-lan-ip>/).
HTTP_PORT=80

# Extra browser origins allowed to call the API, comma-separated. Leave empty
# when everything is served through the bundled nginx (same origin).
CORS_ORIGINS=

# Named Cloudflare Tunnel token. Only used with: --profile tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Game clock. Keep 60000 (1 game minute = 60 s) for the real event.
# 6000 runs the full 30-minute game in 3 wall minutes for rehearsals.
ENGINE_MINUTE_MS=60000
# Price/bot tick interval.
ENGINE_TICK_MS=1000
# 1 = log engine mutation-queue timings every 10 s (diagnostics only).
ENGINE_PROFILE=0

# Stateless replicas behind nginx.
API_REPLICAS=4
GATEWAY_REPLICAS=2

# =====================================================================
# 2. Local development without Docker for the apps (pnpm dev)
# =====================================================================
# Copy this file to .env, then UNCOMMENT this block and replace section 1's
# empty JWT_SECRET / CORS_ORIGINS lines with these (empty values break pnpm dev).
#
# NODE_ENV=development
# DATABASE_URL=postgresql://qtp:qtp@localhost:5432/qtp
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=dev-only-change-me-0000000000000000000000000000000000000000
# CORS_ORIGINS=http://localhost:3000
# API_PORT=8000
# GATEWAY_PORT=8080
# ENGINE_TICK_MS=250
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8080
# Hosts allowed to reach `next dev` from other devices, comma-separated:
# ALLOWED_DEV_ORIGINS=
# "false" seeds only the admin (needs ADMIN_PASSWORD); default also seeds demo data.
# SEED_DEMO_DATA=true

# =====================================================================
# 3. Dry-run / load-test accounts (rehearsal only; pass on the command line)
# =====================================================================
# db:seed-loadtest creates <prefix>0001..<prefix>N with one shared password and
# refuses to run with NODE_ENV=production unless ALLOW_TEST_USERS=1.
# Never leave LOADTEST_PASSWORD empty: an empty value becomes a blank password.
#
# LOADTEST_USERS=20
# LOADTEST_PREFIX=lt
# LOADTEST_PASSWORD=<choose-a-test-password>
# ALLOW_TEST_USERS=1

# =====================================================================
# 4. IITB ITC SSO (https://sso.tech-iitb.org/docs/)
# =====================================================================
# Register the project at sso.tech-iitb.org with:
#   Main url:     https://<event-domain>/
#   Redirect url: https://<event-domain>/api/auth/callback
# then paste the Project ID. Leave empty to disable SSO (password form only).
ITC_SSO_PROJECT_ID=
# ITC_SSO_BASE_URL=https://sso.tech-iitb.org
